{
    "name": "youvision/think-qrcode",
    "description": "基于 endroid/qr-code 的 ThinkPHP 8 二维码生成组件",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "qrcode",
        "qr-code",
        "endroid"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "indiboy-create",
            "homepage": "https://github.com/indiboy-create"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "endroid/qr-code": "^5.1 || ^6.0",
        "topthink/framework": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "youvision\\think\\qrcode\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "think": {
            "services": [
                "youvision\\think\\qrcode\\Service"
            ]
        }
    },
    "config": {
        "prefer-stable": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}